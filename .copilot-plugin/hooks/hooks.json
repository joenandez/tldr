{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/tldr-agents\" messaging hook session-start --runtime copilot"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/tldr-agents\" messaging hook user-prompt-submit --runtime copilot"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/../bin/tldr-agents\" messaging hook post-tool-use --runtime copilot"
          }
        ]
      }
    ]
  }
}
