  "scripts": {
    "pretest": "NODE_OPTIONS=--conditions=tldr-agent-test node --test tests/test_provenance_manifest.mjs",
    "test": "npm run test:starport && npm run test:product",
    "test:starport": "NODE_OPTIONS=--conditions=tldr-agent-test node --test tests/test_starport_plugin_contract.mjs tests/test_starport_activation.mjs tests/test_starport_native_lifecycle.mjs tests/test_starport_orchestrator.mjs tests/test_starport_onboarding.mjs tests/test_starport_front_door.mjs tests/test_starport_uninstall.mjs tests/test_starport_release_closure.mjs tests/test_tldr_tightbeam_packed_cross_product.mjs tests/test_tightbeam_channel_real_daemon.mjs tests/test_tightbeam_email_inbound_bridge.mjs tests/test_tightbeam_email_inbound_real_daemon.mjs tests/test_tightbeam_email_outbound_adapter.mjs tests/test_tightbeam_email_outbound_real_daemon.mjs",
    "test:release": "node --test tests/test_public_release_export.mjs tests/test_release_skill.mjs",
    "test:product": "NODE_OPTIONS=--conditions=tldr-agent-test node --test --test-concurrency=1 tests/test_tldr_agent_tightbeam_retirement.mjs tests/test_aegis_setup_registration_ux.mjs tests/test_aegis_protocol.mjs tests/test_tldr_agent_agentmail_transport.mjs tests/test_tldr_agent_daemon_polling.mjs tests/test_tightbeam_email_outbound_adapter.mjs tests/test_tldr_agent_attachment_behavior.mjs",
    "test:tightbeam-cross-product": "TIGHTBEAM_CROSS_PRODUCT_REQUIRED=1 NODE_OPTIONS=--conditions=tldr-agent-test node --test tests/test_tldr_tightbeam_packed_cross_product.mjs",
    "test:packed-acceptance": "node --test tests/test_tldr_agent_packed_acceptance.mjs",
    "test:tldr-agent-contracts": "NODE_OPTIONS=--conditions=tldr-agent-test node --test --test-reporter=tap tests/contracts/test_tldr_agent_exclusions.mjs",
    "test:aegis-outbound": "NODE_OPTIONS=--conditions=tldr-agent-test node --test tests/test_aegis_phase4_outbound.mjs tests/test_aegis_phase8_artifact_verifier.mjs tests/test_aegis_phase8_evidence.mjs",
    "test:aegis-integration": "NODE_OPTIONS=--conditions=tldr-agent-test node --test tests/test_aegis_full_uninstall.mjs tests/test_aegis_package_daemon_activation.mjs tests/test_aegis_setup_registration_ux.mjs tests/test_aegis_three_inbox_live_harness.mjs",
    "test:tldr-agent-wave-contracts": "NODE_OPTIONS=--conditions=tldr-agent-test node --test --test-reporter=tap tests/contracts/test_tldr_agent_email_only_exclusions.mjs tests/contracts/test_tldr_agent_private_resume_prune.mjs tests/contracts/test_tldr_agent_minimum_runtime_closure.mjs",
    "test:tldr-agent-minimum-runtime": "NODE_OPTIONS=--conditions=tldr-agent-test node --test tests/contracts/test_tldr_agent_minimum_runtime_closure.mjs",
    "test:tldr-agent-contracts:red": "NODE_OPTIONS=--conditions=tldr-agent-test node scripts/verify-tldr-agent-contract-red.mjs",
    "test:e2e:tldr-agent": "node scripts/run-tldr-agent-e2e.mjs",
    "test:e2e:tldr-agent:preflight": "node scripts/run-tldr-agent-e2e.mjs --preflight",
    "coverage": "c8 --reporter=text --reporter=text-summary --reporter=lcov --include='src/**/*.mjs' --check-coverage --lines=80 --branches=70 --functions=85 --statements=80 npm test",
    "coverage:report": "c8 --reporter=text --reporter=text-summary --include='src/**/*.mjs' npm test",
    "lint": "node scripts/check-file-size.mjs && qlty check",
    "provenance": "node scripts/generate-tldr-agent-package-closure.mjs",
    "release:public:export": "node scripts/export-public-release.mjs",
    "release:source-archive": "node scripts/build-starport-source-archive.mjs",
    "qa:aegis:candidate": "node scripts/prepare-aegis-qa-candidate.mjs",
    "preflight": "scripts/preflight.sh"
  },
