#!/bin/sh
set -eu

script_path=$0
if [ -L "$script_path" ]; then
  link_target=$(/usr/bin/readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$(dirname -- "$script_path")/$link_target ;;
  esac
fi
plugin_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd -P)
TLDR_AGENT_PLUGIN_ROOT=$plugin_root
export TLDR_AGENT_PLUGIN_ROOT
operation=${1:-configure}
case "$operation" in
  setup|status|configure|repair|uninstall)
    if [ "$#" -gt 0 ]; then shift; fi
    exec "${plugin_root}/install/tldr-agent-bootstrap.sh" \
      --package-root "${plugin_root}" \
      --operation "${operation}" "$@"
    ;;
esac

tldr_agent_home=${TLDR_AGENT_HOME:-${HOME}/.tldr-agent}
install_root="${tldr_agent_home}/install"
runtime_node="${install_root}/runtime/bin/node"
message_entrypoint="${install_root}/tldr-agent/src/tldr-agent.mjs"
installed_manifest="${install_root}/activation-manifest.json"
plugin_manifest="${plugin_root}/release/activation-manifest.json"
if [ -x "$runtime_node" ] && [ -f "$message_entrypoint" ] && \
   [ -f "$installed_manifest" ] && [ -f "$plugin_manifest" ]; then
  installed_release=$(/usr/bin/plutil -extract release raw -o - "$installed_manifest" 2>/dev/null || true)
  plugin_release=$(/usr/bin/plutil -extract release raw -o - "$plugin_manifest" 2>/dev/null || true)
  if [ -n "$installed_release" ] && [ "$installed_release" = "$plugin_release" ]; then
    PATH="${install_root}/runtime/bin:/usr/bin:/bin"
    export PATH TLDR_AGENT_HOME
    exec "$runtime_node" "$message_entrypoint" "$@"
  fi
fi
printf '%s\n' '{"ok":false,"data":null,"error":{"code":"STARPORT_SETUP_REQUIRED","message":"tldr; setup is required before messaging.","retryable":false,"remediation":"Set up tldr;"}}'
exit 69
