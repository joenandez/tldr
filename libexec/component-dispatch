#!/bin/sh
# Runs one imported component CLI on the Node runtime carried by this package's
# own release payload. Usage: component-dispatch <component> [args...]
#
# `component-dispatch --resolve <component>` runs the same verification and
# extraction, then prints node=, entrypoint=, and sha256= lines instead of
# running the component. The tldr-agent poll child uses it to verify the
# payload once per poll tick and run that tick's Tightbeam calls on the
# verified runtime (item 38 option E); any failure exits non-zero as below.
#
# The payload is verified against release/activation-manifest.json, so a
# package whose payload is later removed or altered fails closed. A full
# sha256 runs once per payload: the verified result is recorded under
# runtimes/.verified-payloads with the file identity (device, inode, size,
# mtime and ctime to the nanosecond, mode) of the manifest and the payload, and a
# later run trusts it only while both identities are unchanged (ac-jfv.152).
# Any write to either file changes its ctime, so it is digested again. On
# macOS there is no fallback to PATH or to the lifecycle runtime under
# install/, which the bootstrap owns. Linux has no payload; it runs the system
# Node (>= 24.20).
set -eu

fail() {
  printf 'tldr-agent runtime: %s: %s\n' "$2" "$3" >&2
  exit "$1"
}

resolve_only=0
if [ "${1:-}" = "--resolve" ]; then
  resolve_only=1
  shift
  [ "$#" -le 1 ] || fail 64 RUNTIME_COMPONENT_UNKNOWN "--resolve takes one component"
fi
[ "$#" -gt 0 ] || fail 64 RUNTIME_COMPONENT_UNKNOWN "no component named"
component=$1
shift
case "$component" in
  helm-tasks) entrypoint=scheduling/src/helm-tasks.mjs ;;
  helm-assignments) entrypoint=scheduling/src/helm-assignments.mjs ;;
  tightbeam) entrypoint=messaging/bin/tightbeam ;;
  tightbeam-daemon) entrypoint=messaging/bin/tightbeam-daemon ;;
  # Email-intent drafts must work before any email install, so they run on
  # this verified runtime rather than the lifecycle runtime under install/.
  email-drafts) entrypoint=src/email-drafts.mjs ;;
  # Cold status reads capability health before any lifecycle release exists,
  # so its probe also runs here (install/tldr-agent-bootstrap.sh).
  tldr-capabilities) entrypoint=src/tldr-capabilities.mjs ;;
  # Linux setup, status, and repair (no bootstrap there).
  tldr-linux-setup) entrypoint=src/lib/linux_setup.mjs ;;
  # Slack setup, status, repair, and disconnect (macOS and Linux alike).
  tldr-slack-setup) entrypoint=src/lib/slack_setup_entry.mjs ;;
  # Slack per-agent channels (`slack channels add`).
  tldr-slack-channels) entrypoint=src/lib/slack_channels_entry.mjs ;;
  *) fail 64 RUNTIME_COMPONENT_UNKNOWN "unknown component: $component" ;;
esac

# Parameter expansion, not dirname: this runs on every CLI call (ac-jfv.152).
case "$0" in
  */*) script_dir=${0%/*} ;;
  *) script_dir=. ;;
esac
package_root=$(CDPATH= cd -- "${script_dir:-/}/.." && pwd -P) || \
  fail 68 RUNTIME_MANIFEST_MISSING "cannot resolve the package root from $0"
manifest="${package_root}/release/activation-manifest.json"
package_root_is_git_worktree() {
  [ -e "${package_root}/.git" ] && return 0
  [ -x /usr/bin/git ] || return 1
  git_top=$(/usr/bin/git -C "$package_root" rev-parse --show-toplevel 2>/dev/null) || return 1
  git_top=$(CDPATH= cd -- "$git_top" && pwd -P) || return 1
  [ "$git_top" = "$package_root" ]
}
case "$component" in
  helm-tasks|helm-assignments)
    if ! package_root_is_git_worktree; then
      HELM_CANONICAL_CHECKOUT="${package_root}/scheduling"
      export HELM_CANONICAL_CHECKOUT
    fi
    ;;
esac

# Linux has no release payload: run the system node, held to the engine floor.
# The macOS payload verification below does not run there.
if [ "$(uname -s)" = "Linux" ]; then
  runtime_node=$(command -v node) || \
    fail 67 RUNTIME_NODE_UNSUPPORTED "node >= 24.20 is not on PATH"
  "$runtime_node" -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 24 || (a === 24 && b >= 20) ? 0 : 1)' || \
    fail 67 RUNTIME_NODE_UNSUPPORTED "node >= 24.20 is required"
  if [ "$resolve_only" = 1 ]; then
    printf 'node=%s\nentrypoint=%s\nsha256=\n' "$runtime_node" "${package_root}/${entrypoint}"
    exit 0
  fi
  exec "$runtime_node" "${package_root}/${entrypoint}" "$@"
fi


tab='	'
newline='
'
# A file's identity: device, inode, size, mtime and ctime to the nanosecond,
# and permission bits, of the file a link resolves to (-L), since plutil and
# openssl read that file. Any write, rename over, relink, or chmod changes it.
file_identity() {
  /usr/bin/stat -L -f '%d:%i:%z:%Fm:%Fc:%Lp' "$@" 2>/dev/null
}

# The state root default (src/lib/store.mjs). The runtime cache is exempt
# from the state root migration guard: it is regenerated on demand.
runtimes=""
if [ -n "${TLDR_AGENT_HOME:-}${HOME:-}" ]; then
  tldr_agent_home=${TLDR_AGENT_HOME:-${HOME}/.tldr-agents/agent}
  runtimes="${tldr_agent_home}/runtimes"
fi
verified_record="${runtimes}/.verified-payloads"
runtime_stamp_name=.payload-sha256
use_runtime() {
  runtime="${runtimes}/${actual_sha}"
  runtime_node="${runtime}/bin/node"
  runtime_stamp="${runtime}/${runtime_stamp_name}"
}

# The stamp is written inside the staged runtime before its rename, so only an
# entry this dispatcher completed carries the verified sha256. Anything else
# under runtimes/<sha256>/, including links, is replaced and never executed.
runtime_is_trusted() {
  [ -d "$runtimes" ] && [ ! -L "$runtimes" ] && [ -O "$runtimes" ] || return 1
  [ -d "$runtime" ] && [ ! -L "$runtime" ] && [ -O "$runtime" ] || return 1
  [ -f "$runtime_stamp" ] && [ ! -L "$runtime_stamp" ] || return 1
  stamp=""
  IFS= read -r stamp 2>/dev/null < "$runtime_stamp" || :
  [ "$stamp" = "$actual_sha" ] && [ -x "$runtime_node" ]
}

launch() {
  if [ "$resolve_only" = 1 ]; then
    printf 'node=%s\nentrypoint=%s\nsha256=%s\n' \
      "$runtime_node" "${package_root}/${entrypoint}" "$actual_sha"
    exit 0
  fi
  exec "$runtime_node" "${package_root}/${entrypoint}" "$@"
}

# The record is one line per package root: root, manifest identity, payload
# path, verified sha256, payload identity. It is trusted only as a regular
# file this user owns, in a runtimes/ directory this user owns with mode 0700.
record_is_trusted() {
  [ -n "$runtimes" ] && [ -d "$runtimes" ] && [ ! -L "$runtimes" ] && [ -O "$runtimes" ] || return 1
  [ -f "$verified_record" ] && [ ! -L "$verified_record" ] && [ -O "$verified_record" ]
}

# Sets relative_path and actual_sha from this root's record line when the
# manifest and payload still have the identities recorded at verification.
recorded_payload_matches() {
  record_is_trusted || return 1
  while IFS="$tab" read -r r_root r_manifest r_path r_sha r_payload; do
    [ "$r_root" = "$package_root" ] || continue
    case "$r_path" in
      ""|/*|../*|*/../*|*/..) return 1 ;;
    esac
    case "$r_sha" in
      *[!0-9a-f]*|"") return 1 ;;
    esac
    [ "${#r_sha}" -eq 64 ] || return 1
    # The same stat call checks that runtimes/ is still private (0700).
    identities=$(file_identity "$manifest" "${package_root}/${r_path}" "$runtimes") || return 1
    case "$identities" in
      "${r_manifest}${newline}${r_payload}${newline}"*:700) ;;
      *) return 1 ;;
    esac
    relative_path=$r_path
    actual_sha=$r_sha
    return 0
  done < "$verified_record"
  return 1
}

# Rewrites the record with this root's line, keeping lines for other roots
# whose manifest still exists. A lost race only costs a later full digest.
remember_verified_payload() {
  [ -n "$manifest_identity" ] && [ -n "$payload_identity" ] || return 0
  case "${package_root}${relative_path}" in
    *"$tab"*|*"$newline"*) return 0 ;;
  esac
  # Whole-second timestamps (HFS+) cannot show a rewrite within the second of
  # verification, so such files are digested on every call, as before.
  case "${manifest_identity}${newline}${payload_identity}" in
    *.000000000:*) return 0 ;;
  esac
  # Never publish through a link or onto a directory: mv would follow it.
  if [ -L "$verified_record" ] || \
    { [ -e "$verified_record" ] && [ ! -f "$verified_record" ]; }; then
    /bin/rm -rf "$verified_record" || return 0
  fi
  next="${verified_record}.$$"
  if {
    if record_is_trusted; then
      while IFS="$tab" read -r r_root r_rest; do
        if [ "$r_root" != "$package_root" ] && \
          [ -f "${r_root}/release/activation-manifest.json" ]; then
          printf '%s\t%s\n' "$r_root" "$r_rest"
        fi
      done < "$verified_record"
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$package_root" "$manifest_identity" \
      "$relative_path" "$actual_sha" "$payload_identity"
  } > "$next" && /bin/mv -f "$next" "$verified_record"; then
    return 0
  fi
  /bin/rm -f "$next" 2>/dev/null || :
  printf 'tldr-agent runtime: event=runtime_verified_record_unwritable path=%s\n' \
    "$verified_record" >&2
}

# Fast path: a payload verified earlier, unchanged since, on a trusted runtime.
# A record is only written after the darwin/arm64 check below passed for
# these same files, so the fast path skips that check.
if recorded_payload_matches; then
  use_runtime
  runtime_is_trusted && launch "$@"
fi

host=$(/usr/bin/uname -sm)
[ "$host" = "Darwin arm64" ] || \
  fail 67 RUNTIME_ARCHITECTURE_UNSUPPORTED \
    "only darwin/arm64 is supported, found ${host% *}/${host##* }"
architecture=arm64

[ -f "$manifest" ] || \
  fail 68 RUNTIME_MANIFEST_MISSING "release/activation-manifest.json is absent"

field() {
  /usr/bin/plutil -extract "$1" raw -o - "$manifest" 2>/dev/null
}
manifest_identity=$(file_identity "$manifest") || manifest_identity=""
[ "$(field schema_version)" = "1" ] || \
  fail 68 RUNTIME_MANIFEST_INVALID "unsupported activation manifest schema"
prefix="architectures.${architecture}.runtime"
relative_path=$(field "${prefix}.path") || relative_path=""
expected_bytes=$(field "${prefix}.bytes") || expected_bytes=""
expected_sha=$(field "${prefix}.sha256") || expected_sha=""
case "$relative_path" in
  ""|/*|../*|*/../*|*/..)
    fail 68 RUNTIME_MANIFEST_INVALID "runtime payload path is invalid" ;;
esac
[ -n "$expected_bytes" ] && [ -n "$expected_sha" ] || \
  fail 68 RUNTIME_MANIFEST_INVALID "runtime payload digest is incomplete"

archive="${package_root}/${relative_path}"
[ -f "$archive" ] || \
  fail 68 RUNTIME_PAYLOAD_MISSING "${relative_path} is absent"
payload_identity=$(file_identity "$archive") || payload_identity=""
actual_bytes=$(/usr/bin/stat -f %z "$archive") || actual_bytes=""
lowercase() {
  printf '%s\n' "$1" | /usr/bin/tr 'A-F' 'a-f'
}
# openssl digests the payload several times faster than shasum. Without a
# well-formed digest the payload is unverified, so the run stops here.
[ -x /usr/bin/openssl ] || \
  fail 68 RUNTIME_DIGEST_UNAVAILABLE "/usr/bin/openssl is absent"
digest=$(/usr/bin/openssl dgst -sha256 -r "$archive" 2>/dev/null) || \
  fail 68 RUNTIME_DIGEST_UNAVAILABLE "/usr/bin/openssl cannot digest ${relative_path}"
actual_sha=$(lowercase "${digest%%[[:space:]]*}")
case "$actual_sha" in
  *[!0-9a-f]*|"")
    fail 68 RUNTIME_DIGEST_UNAVAILABLE "/usr/bin/openssl gave no sha256 for ${relative_path}" ;;
esac
[ "${#actual_sha}" -eq 64 ] || \
  fail 68 RUNTIME_DIGEST_UNAVAILABLE "/usr/bin/openssl gave no sha256 for ${relative_path}"
[ "$actual_bytes" = "$expected_bytes" ] && [ "$actual_sha" = "$(lowercase "$expected_sha")" ] || \
  fail 68 RUNTIME_PAYLOAD_MISMATCH "${relative_path} does not match its sha256 and size"

[ -n "$runtimes" ] || \
  fail 70 RUNTIME_HOME_UNAVAILABLE "set TLDR_AGENT_HOME or HOME"
use_runtime

# runtimes/ holds only this user's runtimes. A link there is removed (never its
# target) and the directory is recreated private.
prepare_runtimes() {
  if [ -L "$runtimes" ]; then
    printf 'tldr-agent runtime: event=runtime_cache_link_removed path=%s\n' \
      "$runtimes" >&2
    /bin/rm -f "$runtimes" || \
      fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot remove the link at ${runtimes}"
  fi
  /bin/mkdir -p -m 0700 "$runtimes" || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot create ${runtimes}"
  [ -d "$runtimes" ] && [ ! -L "$runtimes" ] || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "${runtimes} is not a directory"
  [ -O "$runtimes" ] || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "${runtimes} is not owned by the current user"
  /bin/chmod 0700 "$runtimes" || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot restrict ${runtimes} to the current user"
}

stage=""
discard_stage() {
  [ -z "$stage" ] || /bin/rm -rf "$stage"
}

# Move an untrusted entry aside in one rename, so no caller sees it half
# removed; rm then removes a link itself, never its target.
discard_untrusted_runtime() {
  [ -e "$runtime" ] || [ -L "$runtime" ] || return 0
  printf 'tldr-agent runtime: event=runtime_cache_untrusted path=%s\n' \
    "$runtime" >&2
  untrusted="${runtimes}/.untrusted.$$"
  /bin/rm -rf "$untrusted" || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot clear ${untrusted}"
  # A concurrent caller may already have moved the same entry aside.
  /bin/mv "$runtime" "$untrusted" 2>/dev/null || :
  /bin/rm -rf "$untrusted" || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot remove the untrusted runtime moved to ${untrusted}"
}

# Extract beside the cache entry and rename only a complete, stamped runtime
# into place, so an interrupted extraction is never found under
# runtimes/<sha256>/.
extract_runtime() {
  prepare_runtimes
  trap discard_stage EXIT
  trap 'discard_stage; exit 130' HUP INT TERM
  stage=$(/usr/bin/mktemp -d "${runtimes}/.extract.XXXXXX") || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot stage under ${runtimes}"
  /usr/bin/tar -xzf "$archive" --strip-components=1 -C "$stage" || \
    fail 69 RUNTIME_EXTRACT_FAILED "cannot extract ${relative_path}"
  [ -x "${stage}/bin/node" ] || \
    fail 69 RUNTIME_EXTRACT_FAILED "${relative_path} has no executable bin/node"
  printf '%s\n' "$actual_sha" > "${stage}/${runtime_stamp_name}" || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot stamp the runtime staged in ${stage}"
  /bin/chmod -R go-rwx "$stage" || \
    fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot restrict the runtime staged in ${stage} to the current user"
  if ! runtime_is_trusted; then
    discard_untrusted_runtime
    /bin/mv "$stage" "$runtime" || \
      fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot rename into ${runtime}"
    # If a concurrent first run renamed its runtime first, mv nested this
    # stage inside that runtime instead of replacing it.
    /bin/rm -rf "${runtime}/${stage##*/}" || \
      fail 70 RUNTIME_CACHE_UNAVAILABLE "cannot remove ${runtime}/${stage##*/}"
    printf 'tldr-agent runtime: event=runtime_extracted sha256=%s path=%s\n' \
      "$actual_sha" "$runtime" >&2
  fi
  discard_stage
  stage=""
  trap - EXIT HUP INT TERM
  runtime_is_trusted || \
    fail 69 RUNTIME_EXTRACT_FAILED "${runtime} is incomplete after extraction"
}

runtime_is_trusted || extract_runtime
remember_verified_payload
launch "$@"
