#!/bin/sh
set -eu

script_path=$0
if [ -L "$script_path" ]; then
  link_target=$(/usr/bin/readlink "$script_path")
  case "$link_target" in
    /*) script_path=$link_target ;;
    *) script_path=$(dirname -- "$script_path")/$link_target ;;
  esac
fi
plugin_root=$(CDPATH= cd -- "$(dirname -- "$script_path")/.." && pwd -P)
TLDR_AGENT_PLUGIN_ROOT=$plugin_root
export TLDR_AGENT_PLUGIN_ROOT
tldr_version() {
  local_manifest="${plugin_root}/LOCAL-SNAPSHOT-MANIFEST.json"
  if [ -f "$local_manifest" ]; then
    if version=$(/usr/bin/plutil -extract localVersion raw -o - "$local_manifest" 2>/dev/null); then
      printf '%s\n' "$version"
      return
    fi
  fi
  /usr/bin/plutil -extract version raw -o - "${plugin_root}/package.json" 2>/dev/null
}
case "${1:-}" in
  --version|-v|version)
    version=$(tldr_version) || {
      echo "tldr-agent: version metadata is unavailable" >&2
      exit 70
    }
    if [ "${2:-}" = "--json" ]; then
      printf '{"ok":true,"data":{"version":"%s"},"error":null}\n' "$version"
    else
      printf '%s\n' "$version"
    fi
    exit 0
    ;;
esac
tldr_default_operation() {
  if [ "${TLDR_AGENT_ASSUME_GUI_SESSION:-}" = "0" ]; then printf 'status'; return; fi
  if [ "${TLDR_AGENT_ASSUME_GUI_SESSION:-}" = "1" ]; then printf 'configure'; return; fi
  if [ -n "${CI:-}" ]; then printf 'status'; return; fi
  if [ "$(/bin/launchctl managername 2>/dev/null || true)" = "Aqua" ]; then
    printf 'configure'
  else
    printf 'status'
  fi
}
operation=${1:-$(tldr_default_operation)}
# Opening the installed app and reading help do not require an active runtime.
case "$operation" in
  configure|--help|-h|help)
    if [ "$#" -gt 0 ]; then shift; fi
    exec "${plugin_root}/install/tldr-agent-bootstrap.sh" \
      --package-root "${plugin_root}" --operation "${operation}" "$@"
    ;;
esac
for argument in "$@"; do
  case "$argument" in
    --help|-h)
      exec "${plugin_root}/install/tldr-agent-bootstrap.sh" \
        --package-root "${plugin_root}" --operation "$operation" --help
      ;;
  esac
done
case "$operation" in
  setup|status|repair|uninstall)
    if [ "$#" -gt 0 ]; then shift; fi
    if [ -f "${plugin_root}/LOCAL-SNAPSHOT-MANIFEST.json" ]; then
      tldr_agent_home=${TLDR_AGENT_HOME:-${HOME}/.tldr-agents/agent}
      runtime_node="${tldr_agent_home}/install/runtime/bin/node"
      if [ ! -x "${runtime_node}" ]; then
        exec "${plugin_root}/install/tldr-agent-bootstrap.sh" \
          --package-root "${plugin_root}" \
          --operation "${operation}" "$@"
      fi
      exec "${runtime_node}" "${plugin_root}/src/lib/local_snapshot_front_door.mjs" \
        "${operation}" "$@"
    fi
    exec "${plugin_root}/install/tldr-agent-bootstrap.sh" \
      --package-root "${plugin_root}" \
      --operation "${operation}" "$@"
    ;;
esac
printf '%s\n' '{"ok":false,"data":null,"error":{"code":"STARPORT_OPERATION_UNSUPPORTED","message":"tldr; supports lifecycle operations only.","retryable":false,"remediation":"Check tldr;"}}'
exit 2
